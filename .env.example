# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://sarex:sarex-local-only@localhost:5433/sarex
APP_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
SESSION_COOKIE_NAME=sarex_session
SESSION_TTL_HOURS=720
SESSION_IDLE_TIMEOUT_HOURS=720
COOKIE_SAME_SITE=lax
CSRF_SECRET=development-only-change-this-before-production
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=
TRUST_PROXY=false
VITE_API_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
